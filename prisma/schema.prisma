generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String?
  password            String?
  role                Role     @default(RIZADA)
  tokens              Int      @default(0)
  hairType            String?
  curlType            String?
  avatar              String?
  bio                 String?
  verified            Boolean  @default(false)
  stellarPublicKey    String?
  stellarSecretKey    String?
  onboardingCompleted Boolean  @default(false)
  latitude            Float?
  longitude           Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  passwordResetTokens PasswordResetToken[]

  posts         Post[]
  tokenTxs      TokenTransaction[]
  appointments  Appointment[] @relation("ClientAppointments")
  stylistAppointments Appointment[] @relation("StylistAppointments")
  reviews       Review[]      @relation("ReviewAuthor")
  stylistReviews Review[]       @relation("StylistReviews")
  purchases     Purchase[]
  discountCodes DiscountCode[]
  following     Follow[] @relation("FollowFollower")
  followers     Follow[] @relation("FollowFollowing")

  @@index([createdAt])
  @@index([stellarPublicKey])

}
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Purchase {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  walletAddress String?
  /// Catalog snapshots for all products covered by this single payment.
  items         Json     @default("[]")
  productName   String
  precioUSDC    Float
  tokensGanados Int
  /// Stellar transaction hash. Unique so a blockchain payment can credit an
  /// order at most once (idempotency). Null while the order is still PENDING.
  stellarTxHash String?  @unique
  /// PENDING -> COMPLETED on confirmed Horizon submission, FAILED if unrecoverable.
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

model Post {
  id        String   @id @default(cuid())
  content   String
  imageUrl  String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  tokenPrice  Int      @default(0)
  imageUrl    String?
  brandName   String
  rating      Float    @default(0)
  votes       Int      @default(0)
  category    String?
  hairTypes   String?
  createdAt   DateTime @default(now())

  reviews Review[]
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  content   String?
  curlType  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  stylistId String?
  stylist   User?    @relation("StylistReviews", fields: [stylistId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([stylistId])
  @@index([userId])
}

model TokenTransaction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  type            String
  reason          String
  stellarTxHash   String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model DiscountCode {
  id          String    @id @default(cuid())
  code        String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  description String
  discount    Int
  tokensUsed  Int
  used        Boolean   @default(false)
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model Appointment {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("ClientAppointments", fields: [userId], references: [id], onDelete: Cascade)
  stylistName  String
  stylistId    String?
  stylist      User?    @relation("StylistAppointments", fields: [stylistId], references: [id], onDelete: SetNull)
  date         DateTime
  notes        String?
  tokensUsed   Int      @default(0)
  usdcAmount   Float    @default(0)
  status       String   @default("pending")
  stellarTxHash String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([stylistId, date])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model WalletChallenge {
  id        String    @id @default(cuid())
  address   String
  nonce     String    @unique
  message   String
  email     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([address])
}

enum Role {
  RIZADA
  MARCA
  ESTILISTA
}
